<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BryanZongSheng33523355"
        tools:targetApi="31">

        <activity
            android:name=".RegisterScreenActivity"
            android:exported="false"
            android:label="@string/title_activity_register_screen"
            android:theme="@style/Theme.BryanZongSheng33523355" />
        <activity
            android:name=".HomeScreenActivity"
            android:exported="false"
            android:label="@string/title_activity_home_screen"
            android:theme="@style/Theme.BryanZongSheng33523355" />
        <activity
            android:name=".QuestionnaireActivity"
            android:exported="false"
            android:label="@string/title_activity_questionnaire"
            android:theme="@style/Theme.BryanZongSheng33523355" />
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:label="@string/title_activity_login"
            android:theme="@style/Theme.BryanZongSheng33523355" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.BryanZongSheng33523355">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>